DATABASE_URL=postgresql://postgres:postgres@db:5432/yieldscreener
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ── yfinance data refresh (temporary until marketdata.app swap) ──────────────
# How often (seconds) the background scheduler re-fetches all market data.
# Screener reads from Redis only — Yahoo Finance is NEVER called on a user request.
YF_REFRESH_INTERVAL=600

# Seconds to wait between retries when Yahoo returns 429.
YF_RETRY_SLEEP=1.0

# Max retry attempts per ticker before skipping it.
YF_MAX_RETRIES=3

# User-Agent header sent to Yahoo Finance (helps avoid rate-limit bot detection).
YF_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
